# Copy this file to .env and fill in your own NRP credentials. NEVER commit .env.
# Ask the instructor for the token if you don't have one.
NRP_API_KEY=your_nrp_api_key_here
NRP_BASE_URL=https://ellm.nrp-nautilus.io/v1

# Optional settings
# BUDGETWISE_MODEL=gpt-oss        # model for all agents (gpt-oss was fastest in our timing tests)
# BUDGETWISE_TIMEOUT=45           # seconds before an agent falls back to the calculated numbers
# BUDGETWISE_TODAY=2026-11-10     # pin "today" for repeatable tests and demos
